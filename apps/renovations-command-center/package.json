{
  "name": "renovations-command-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "firebase:configure": "node --import tsx scripts/configure-firebase.mjs",
    "firebase:check": "node --import tsx scripts/check-firebase.mjs",
    "dev:firebase": "node scripts/local-firebase.mjs",
    "test:firebase-http": "node scripts/local-firebase.mjs --verify",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:backend": "node --import tsx --test --test-concurrency=1 tests/firestore-rules.test.mjs tests/storage-rules.test.mjs tests/task-commands.integration.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  }
}
