rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isProjectOwner(projectId) {
      return request.auth != null
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUserId == request.auth.uid;
    }

    function isProjectOwnerAfter(projectId) {
      return request.auth != null
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.ownerUserId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid
        && !request.resource.data.keys().hasAny(['restoredFrom', 'restoredBy', 'restoredAt', 'restoreDigest', 'creationDigest']);

      allow read, delete: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['restoredFrom', 'restoredBy', 'restoredAt', 'restoreDigest', 'creationDigest']);

      match /rooms/{roomId} {
        allow read: if isProjectOwner(projectId);
        allow create, update, delete: if isProjectOwnerAfter(projectId);
      }

      match /people/{personId} {
        allow read: if isProjectOwner(projectId);
        allow write: if isProjectOwnerAfter(projectId);
      }

      match /tasks/{taskId} {
        allow read: if isProjectOwner(projectId);
        // Historical imports and sensitive execution/proof are server-only.
        allow create: if isProjectOwnerAfter(projectId)
          && request.resource.data.status in ['draft', 'not_ready', 'ready', 'cancelled']
          && request.resource.data.get('actualDurationMinutes', null) == null
          && !request.resource.data.keys().hasAny(['evidenceCount', 'qcPassed', 'qcChecklist', 'qcRequired', 'cureUntil', 'completionOverrideReason', 'overrideAuditId']);
        allow update: if isProjectOwner(projectId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['evidenceCount', 'qcPassed', 'qcChecklist', 'qcRequired', 'cureUntil', 'completionOverrideReason', 'overrideAuditId', 'actualDurationMinutes'])
          && (request.resource.data.status == resource.data.status
            || (resource.data.status in ['draft', 'not_ready', 'ready'] && request.resource.data.status in ['draft', 'not_ready', 'ready', 'cancelled']))
          && (resource.data.status in ['draft', 'not_ready', 'ready']
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photosRequired', 'dependencyTaskIds', 'helperRequired', 'helperPersonIds']));
        allow delete: if isProjectOwner(projectId) && resource.data.status == 'draft' && resource.data.get('evidenceCount', 0) == 0;
      }
      match /{recordKind}/{recordId} {
        allow read: if isProjectOwner(projectId) && recordKind in ['materials', 'tools', 'measurements', 'decisions'];
        allow write: if isProjectOwnerAfter(projectId)
          && recordKind in ['materials', 'tools', 'measurements', 'decisions'];
      }
      match /taskHistory/{historyId} { allow read: if isProjectOwner(projectId); allow create: if false; }
      match /recordHistory/{historyId} { allow read: if isProjectOwner(projectId); allow create: if isProjectOwnerAfter(projectId); }
      match /settings/{settingId} {
        allow read: if isProjectOwner(projectId);
        allow write: if isProjectOwnerAfter(projectId);
      }
      match /scheduleRuns/{runId} {
        allow read: if isProjectOwner(projectId); allow create: if isProjectOwnerAfter(projectId);
      }
      match /evidence/{evidenceId} {
        allow read: if isProjectOwner(projectId);
        allow write: if false;
      }
      match /commandReceipts/{receiptId} {
        allow read: if isProjectOwner(projectId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
