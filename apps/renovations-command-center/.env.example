NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only configuration. Never use NEXT_PUBLIC_ for admin credentials.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_STORAGE_BUCKET=
# Path to an existing, authorized credential file provisioned securely on the host.
# Do not commit the credential file or put its JSON in public/browser settings.
GOOGLE_APPLICATION_CREDENTIALS=

# Actual Free private photo provider. Firebase Storage is for local demo tests only.
RCC_PHOTO_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PHOTO_BUCKET=
# Existing authorized server credential; never expose it in NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
